<!DOCTYPE html>
<html lang="en">
<%- include("../partials/admin_head", { title: "Admin • Products" }) %>



  <body class="admin-body">
    <div class="admin-layout">
      <%- include("../partials/sidebar", { active: "products" }) %>

      <main class="admin-content">
        <%- include("../partials/topbar", { title: "Products" }) %>

        <div class="admin-actions" style="margin-bottom:12px;">
          <a class="admin-btn primary" href="/admin/products/new">+ Add Product</a>
        </div>

        <div class="admin-card">
          <table class="admin-table">
            <thead>
              <tr>
                <th style="width:70px;">Image</th>
                <th>Title</th>
                <th>Category</th>
                <th style="width:110px;">Price</th>
                <th style="width:220px;">Actions</th>
              </tr>
            </thead>

            <tbody>
              <% if (!products || products.length === 0) { %>
                <tr>
                  <td colspan="5" class="muted">No products found.</td>
                </tr>
              <% } else { %>
                <% products.forEach(p => { %>
                  <tr>
                    <td>
                      <img class="admin-thumb" src="<%= p.image %>" alt="<%= p.title %>" />
                    </td>
                    <td><%= p.title %></td>
                    <td><%= p.category %></td>
                    <td>$<%= p.price %></td>
                    <td>
                      <a class="admin-btn" href="/admin/products/<%= p._id %>/edit">Edit</a>

                      <form method="POST" action="/admin/products/<%= p._id %>/delete" style="display:inline;">
                        <button class="admin-btn danger" type="submit"
                          onclick="return confirm('Delete this product?')">
                          Delete
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>

    <%- include("../partials/admin_footer") %>

      </main>
    </div>
  </body>
</html>
