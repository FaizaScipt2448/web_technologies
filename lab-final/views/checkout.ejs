<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Checkout Page</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

  <style>
    body{
      margin:0;
      font-family: Arial, sans-serif;
      background:#5b0f53;
    }
    .site-header{
      position: sticky;
      top: 0;
      z-index: 1000;
      width: 100%;
      background:#4B2B5B;
      box-shadow: 0 2px 6px rgba(0,0,0,.15);
    }
    .topbar{
      display:flex;
      align-items:center;
      gap:24px;
      height:78px;
      padding:0 32px;
      width:100%;
    }
    .brand{
      display:flex; align-items:center; gap:10px;
      font-weight:800; letter-spacing:.25em; text-transform:uppercase; white-space:nowrap;
      color:#fff;
    }
    .brand .be{ color:#20e6e6; }
    .brand .pill{
      display:inline-block; border:4px solid #20e6e6; border-radius:999px;
      padding:.25rem 1.5rem; line-height:1;
    }
    .menu{
      list-style:none; margin:0; padding:0; display:flex; gap:40px;
      margin-left:auto;
    }
    .menu a{
      color:#fff; text-decoration:none; font-weight:800; text-transform:uppercase;
      letter-spacing:.25em; font-size:16px; white-space:nowrap;
    }
    .menu a:hover{ opacity:.85; }
    .buy{
      color:#20e6e6; font-weight:900; text-transform:uppercase; letter-spacing:.25em;
      text-decoration:none; font-size:16px; white-space:nowrap; margin-left:16px;
    }
  </style>
</head>

<body>

<header class="site-header">
  <nav class="topbar">
    <div class="brand">
      <span class="be">BE</span>
      <span class="pill">SURFING</span>
    </div>

    <ul class="menu">
      <li><a href="/">HOME</a></li>
      <li><a href="/about">ABOUT</a></li>
      <li><a href="/crud">SHOP</a></li>
      <li><a href="/cart">CART (<%= cartQty %>)</a></li>
      <li><a href="/checkout">CHECKOUT</a></li>
    </ul>

    <a class="buy" href="#">BUY NOW</a>
  </nav>
</header>

<div class="container my-4">

  <!-- ✅ Cart Summary -->
  <div class="mb-4">
    <div class="alert alert-primary text-center p-2">
      <strong>Checkout</strong>
    </div>

    <% const safeCart = cart || { items: [], totalQty: 0, totalPrice: 0 }; %>
    <% const cartItems = safeCart.items || []; %>

    <% if (!cartItems.length) { %>
      <div class="alert alert-warning">
        <strong>Your cart is empty.</strong>
        <div class="mt-3">
          <a href="/crud" class="btn btn-outline-primary">Go to Shop</a>
        </div>
      </div>
    <% } else { %>
      <div class="p-3 bg-white shadow-sm rounded mb-3">
        <h5 class="mb-3">Cart Summary</h5>

        <table class="table table-sm align-middle">
          <thead>
            <tr>
              <th>Product</th>
              <th>Price</th>
              <th>Qty</th>
              <th>Subtotal</th>
            </tr>
          </thead>
          <tbody>
            <% cartItems.forEach(item => { %>
              <tr>
                <td><%= item.title %></td>
                <td><%= item.price %></td>
                <td><%= item.qty %></td>
                <td><%= item.lineTotal %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>

        <div class="d-flex justify-content-between">
          <strong>Total Items:</strong> <%= safeCart.totalQty %>
          <strong>Total Price:</strong> <%= safeCart.totalPrice %>
        </div>
      </div>
    <% } %>
  </div>

  <!-- ✅ FINAL ORDER FORM -->
  <div class="p-3 bg-white shadow-sm rounded">
    <h4>Customer Information</h4>

    <% const cartIsEmpty = !cartItems.length; %>

    <form method="POST" action="/checkout" class="d-flex flex-column gap-2" style="max-width:400px;">
      <input class="form-control" name="customerName" placeholder="Customer Name" required />
      <input class="form-control" name="email" type="email" placeholder="Email" required />

      <button class="btn btn-success" type="submit" <%= cartIsEmpty ? "disabled" : "" %>>
        Place Order
      </button>

      <% if (cartIsEmpty) { %>
        <div class="text-danger" style="font-size:13px;">
          Add items to cart before placing the order.
        </div>
      <% } %>
    </form>
  </div>
</div>

</body>
</html>
