<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Be Surfing - Our Company</title>

  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      color: #4b2b5b;
      background: #ffffff;
    }
    a { text-decoration: none; }

    /* HERO (TOP PURPLE PART) */
    .hero-about {
      position: relative;
      height: 520px; /* bigger like your 2nd screenshot */
      background: url("/images/home_surfing_subheader.jpg") center/cover no-repeat;
      color: #ffffff;
      overflow: hidden;
    }

    /* optional dark overlay for better text contrast */
    .hero-about::after {
      content: "";
      position: absolute;
      inset: 0;
      background: rgba(0,0,0,0.15);
      pointer-events: none;
    }

    /* NAVBAR */
    .nav {
      position: absolute;
      top: 18px;
      left: 0;
      right: 0;
      padding: 0 28px;
      display: flex;
      align-items: center;
      gap: 16px;
      z-index: 2;
    }

    .brand-img { height: 40px; }

    .menu {
      list-style: none;
      margin: 0 auto;
      padding: 0;
      display: flex;
      gap: 40px;
    }

    .menu a {
      color: white;
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .menu a:hover { opacity: 0.8; }

    .buy {
      color: #20e6e6;
      font-weight: 900;
      font-size: 14px;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    /* CENTER TEXT IN HERO */
    .hero-center {
      position: absolute;
      left: 50%;
      top: 55%;
      transform: translate(-50%, -50%);
      text-align: center;
      z-index: 2;
      width: 90%;
    }

    .hero-center h1 {
      margin: 0 0 14px;
      font-size: 48px;      /* bigger like screenshot */
      letter-spacing: 0.25em;
      text-transform: uppercase;
    }

    /* waves/separator under heading */
    .hero-sep {
      width: 80px;
      height: auto;
      display: inline-block;
    }

    .container {
      width: 80%;
      max-width: 1100px;
      margin: 0 auto;
    }

    .section-intro {
      padding: 70px 0 50px;
      text-align: center;
    }

    .section-intro p {
      margin: 0;
      font-size: 24px;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: #865b9b;
      line-height: 1.6;
    }

    .section-video {
      padding: 20px 0 80px;
      text-align: center;
    }

    .video-box {
      position: relative;
      max-width: 900px;
      margin: 0 auto 20px;
    }

    .video-box img {
      width: 100%;
      height: auto;
      display: block;
    }

    .play-circle {
      width: 70px;
      height: 70px;
      border-radius: 50%;
      background-color: #20e6e6;
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .play-circle span {
      border-style: solid;
      border-width: 10px 0 10px 18px;
      border-color: transparent transparent transparent white;
      margin-left: 4px;
    }

    .video-caption {
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #4b2b5b;
      margin-top: 10px;
      font-size: 14px;
    }

    .section-hotel {
      padding: 40px 0 60px;
    }

    .hotel-row {
      display: flex;
      gap: 40px;
    }

    .hotel-left,
    .hotel-right { flex: 1; }

    .hotel-left img {
      width: 100%;
      height: auto;
      display: block;
    }

    .waves-small {
      width: 70px;
      height: auto;
      margin-bottom: 10px;
    }

    .hotel-right h2 {
      margin: 0 0 16px;
      text-transform: uppercase;
      letter-spacing: 0.22em;
      font-size: 22px;
    }

    .hotel-right p {
      color: #555555;
      line-height: 1.8;
      margin-top: 0;
    }

    .hotel-title {
      margin-top: 26px;
      text-transform: uppercase;
      letter-spacing: 0.25em;
      font-size: 20px;
    }

    .hotel-text {
      color: #555555;
      line-height: 1.8;
      margin-top: 10px;
    }

    .section-why {
      padding: 20px 0 80px;
    }

    .why-row {
      display: flex;
      gap: 60px;
      align-items: flex-start;
    }

    .why-left { flex: 2; }
    .why-right {
      flex: 1.3;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }

    .section-heading {
      text-transform: uppercase;
      letter-spacing: 0.26em;
      font-size: 20px;
      margin: 0 0 16px;
    }

    .section-text {
      color: #555555;
      line-height: 1.8;
      margin-top: 0;
      margin-bottom: 14px;
    }

    .board-img {
      max-height: 260px;
      width: auto;
      align-self: flex-end;
      margin-top: 20px;
    }

    .section-footer {
      background: #8a3f96;
      color: white;
      margin-top: 40px;
    }

    .cta-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 26px 10%;
    }

    .cta-bar h3 {
      margin: 0;
      font-size: 32px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
    }

    .cta-btn {
      background: #20e6e6;
      color: #4b2b5b;
      padding: 10px 24px;
      border-radius: 6px;
      font-weight: bold;
      letter-spacing: 0.15em;
      text-transform: uppercase;
    }

    .footer-links {
      background: #ffffff;
      color: #4b2b5b;
      padding: 40px 10% 50px;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 40px;
    }

    .footer-links h4 {
      margin: 0 0 14px;
      font-size: 18px;
      font-weight: 700;
    }

    .footer-links ul {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .footer-links li {
      margin: 8px 0;
      position: relative;
      padding-left: 14px;
      font-size: 14px;
      color: #7096d6;
    }

    .footer-links li::before {
      content: "▸";
      position: absolute;
      left: 0;
      top: 0;
      color: #7096d6;
    }

    .footer-links a { color: #7096d6; }

    .footer-bottom {
      background: #ffffff;
      border-top: 1px solid #e8edf5;
      text-align: center;
      font-size: 13px;
      padding: 14px 0 18px;
      color: #98a7c4;
    }

    .footer-bottom a { color: #98a7c4; }

    @media (max-width: 900px) {
      .hotel-row,
      .why-row,
      .cta-bar {
        flex-direction: column;
        align-items: flex-start;
      }

      .cta-bar h3 {
        margin-bottom: 12px;
        font-size: 24px;
      }

      .footer-links {
        grid-template-columns: 1fr 1fr;
      }

      .board-img {
        align-self: center;
      }

      .hero-center h1 { font-size: 34px; }
    }

    @media (max-width: 600px) {
      .footer-links { grid-template-columns: 1fr; }
      .section-intro p { font-size: 18px; }
    }
  </style>
</head>

