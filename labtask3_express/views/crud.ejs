<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>FakeStore CRUD</title>

  <!-- ✅ jQuery (FIXED) -->
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"
          integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="
          crossorigin="anonymous"></script>

  <!-- CRUD JS -->
  <script src="/script.js"></script>

  <style>
    /* ===== HEADER (Be Surfing) ===== */
    .site-header{
      position: sticky;
      top: 0;
      z-index: 1000;
      background: #4B2B5B;
    }

    .topbar{
      display:flex;
      align-items:center;
      gap:24px;
      height:78px;
      padding:0 32px;
    }

    .brand{
      display:flex;
      align-items:center;
      gap:10px;
      font-weight:800;
      letter-spacing:.25em;
      text-transform:uppercase;
      white-space:nowrap;
      color:#fff;
    }

    .brand .be{ color:#20e6e6; }
    .brand .pill{
      border:4px solid #20e6e6;
      border-radius:999px;
      padding:.25rem 1.5rem;
      line-height:1;
    }

    .menu{
      list-style:none;
      margin:0 0 0 auto;
      padding:0;
      display:flex;
      gap:40px;
    }

    .menu a{
      color:#fff;
      text-decoration:none;
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:.25em;
      font-size:14px;
    }

    .menu a:hover{ opacity:.85; }

    .buy{
      color:#20e6e6;
      font-weight:900;
      text-transform:uppercase;
      letter-spacing:.25em;
      text-decoration:none;
      font-size:14px;
      margin-left:16px;
    }

    /* ===== CRUD PAGE ===== */
    body{
      font-family: Arial, Helvetica, sans-serif;
      margin: 0;
      background: #f5f5f5;
    }

    .wrap{
      max-width: 1000px;
      margin: 20px auto;
      padding: 0 12px;
    }

    h2{ margin: 10px 0 16px; }

    .box{
      background: #fff;
      border: 1px solid #e5e5e5;
      border-radius: 10px;
      padding: 14px;
      margin-bottom: 16px;
    }

    .row{
      display:flex;
      gap:10px;
      margin-bottom:8px;
      align-items:center;
    }

    .row label{
      width:110px;
      padding-top:2px;
      font-size:14px;
    }

    .row input,
    .row textarea,
    .row select{
      flex:1;
      padding:8px;
      border:1px solid #ddd;
      border-radius:6px;
    }

    .row textarea{
      height:60px;
      resize:vertical;
    }

    .btn{
      padding:8px 12px;
      border:1px solid #ccc;
      background:#eee;
      border-radius:6px;
      cursor:pointer;
    }

    .btn.primary{
      background:#3b82f6;
      border-color:#3b82f6;
      color:#fff;
    }

    .btn:disabled{
      opacity:.6;
      cursor:not-allowed;
    }

    .actions{
      display:flex;
      gap:6px;
      margin-top:8px;
      flex-wrap:wrap;
    }

    .grid{
      display:flex;
      flex-wrap:wrap;
      gap:14px;
    }

    .card{
      background:#fff;
      border:1px solid #e5e5e5;
      border-radius:10px;
      overflow:hidden;
      display:flex;
      flex-direction:column;
      width:220px;
    }

    .card img{
      width:100%;
      height:180px;
      object-fit:contain;
      background:#fff;
    }

    .card .p{ padding:10px; }

    .title{
      font-weight:bold;
      font-size:14px;
      height:38px;
      overflow:hidden;
    }

    .muted{
      color:#666;
      font-size:12px;
    }

    .price{
      font-weight:bold;
      margin-top:6px;
    }

    #loading{
      color:#666;
      padding:10px 0;
    }

    #msg{
      display:none;
      margin-top:8px;
      padding:8px;
      background:#e8f5e9;
      border:1px solid #b6e0c2;
      border-radius:6px;
      color:#155724;
    }
  </style>
</head>

<body>

  <!-- ===== HEADER ===== -->
  <header class="site-header">
    <nav class="topbar">
      <div class="brand">
        <span class="be">BE</span>
        <span class="pill">SURFING</span>
      </div>

      <ul class="menu">
        <li><a href="/">HOME</a></li>
        <li><a href="/about">ABOUT</a></li>
        <li><a href="/crud">CRUD</a></li>
        <li><a href="/checkout">CHECKOUT</a></li>
      </ul>

      <a class="buy" href="#">BUY NOW</a>
    </nav>
  </header>

  <!-- ===== CRUD CONTENT ===== -->
  <div class="wrap">
    <h2>🛒 FakeStore CRUD</h2>

    <!-- ✅ CREATE/UPDATE FORM -->
    <div class="box">
      <h3 id="formTitle" style="margin-top:0;">Create Product</h3>
      <input type="hidden" id="productId" />

      <form id="productForm">
        <div class="row">
          <label>Title</label>
          <input id="title" type="text" placeholder="Product title" />
        </div>

        <div class="row">
          <label>Price</label>
          <input id="price" type="number" placeholder="e.g. 99.99" />
        </div>

        <div class="row">
          <label>Category</label>
          <input id="category" type="text" placeholder="e.g. electronics" />
        </div>

        <div class="row">
          <label>Image URL</label>
          <input id="image" type="text" placeholder="https://..." />
        </div>

        <div class="row">
          <label>Description</label>
          <textarea id="description"></textarea>
        </div>

        <div class="actions">
          <button class="btn primary" type="submit">Save</button>
          <button class="btn" type="button" id="btnReset">Reset</button>
          <span id="msg">Saved!</span>
        </div>
      </form>
    </div>

    <!-- ✅ FILTERS + LIMIT -->
    <div class="box">
      <h3 style="margin-top:0;">Filters</h3>

      <div class="row">
        <label>Category</label>
        <input id="filterCategory" type="text" placeholder="e.g. electronics" />
      </div>

      <div class="row">
        <label>Min Price</label>
        <input id="filterMinPrice" type="number" placeholder="e.g. 50" />
      </div>

      <div class="row">
        <label>Max Price</label>
        <input id="filterMaxPrice" type="number" placeholder="e.g. 200" />
      </div>

      <div class="row">
        <label>Limit</label>
        <select id="limitSelect">
          <option value="6">6</option>
          <option value="10" selected>10</option>
          <option value="12">12</option>
          <option value="20">20</option>
        </select>
      </div>

      <div class="actions">
        <button class="btn primary" type="button" id="applyFilters">Apply</button>
        <button class="btn" type="button" id="clearFilters">Clear</button>
      </div>
    </div>

    <!-- ✅ PRODUCTS LIST -->
    <div class="box">
      <h3>Products</h3>
      <div id="loading">Loading products…</div>
      <div id="productList" class="grid"></div>
      <!-- Pagination buttons will be injected by script.js -->
    </div>

  </div>

</body>
</html>
