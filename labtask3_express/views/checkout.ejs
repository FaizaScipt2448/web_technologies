<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Checkout Page</title>

  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

  <style>
  
    body{
      margin:0;
      font-family: Arial, sans-serif;
      background:#5b0f53;
    }

    .site-header{
      position: sticky;
      top: 0;
      z-index: 1000;
      width: 100%;
      background:#4B2B5B;
      box-shadow: 0 2px 6px rgba(0,0,0,.15);
    }
    .topbar{
      display:flex;
      align-items:center;
      gap:24px;
      height:78px;
      padding:0 32px;
      width:100%;
    }
    .brand{
      display:flex; align-items:center; gap:10px;
      font-weight:800; letter-spacing:.25em; text-transform:uppercase; white-space:nowrap;
    }
    .brand .be{ color:#20e6e6; }
    .brand .pill{
      display:inline-block; border:4px solid #20e6e6; border-radius:999px;
      padding:.25rem 1.5rem; line-height:1;
    }
    .menu{
      list-style:none; margin:0; padding:0; display:flex; gap:40px;
      margin-left:auto;
    }
    .menu a{
      color:#fff; text-decoration:none; font-weight:800; text-transform:uppercase;
      letter-spacing:.25em; font-size:16px; white-space:nowrap;
    }
    .menu a:hover{ opacity:.85; }
    .buy{
      color:#20e6e6; font-weight:900; text-transform:uppercase; letter-spacing:.25em;
      text-decoration:none; font-size:16px; white-space:nowrap; margin-left:16px;
    }

   
    .section6{
      background:#fff;
      color:#4B2B5B;
      width:100vw;
      margin-left:calc(50% - 50vw);
      margin-right:calc(50% - 50vw);
    }

    .section6 .cta-bar{
      background:#6efaf0;
      display:flex; align-items:center; justify-content:space-between;
      gap:20px; padding:28px max(8%, 40px);
    }

    .section6 .cta-bar h3{
      margin:0; font-size:36px; letter-spacing:.15em;
    }

    .section6 .cta-bar .cta-btn{
      background:#fff; color:#4B2B5B; text-decoration:none;
      padding:12px 24px; border-radius:8px; font-weight:600;
      box-shadow:0 0 0 2px rgba(0,0,0,0.04) inset;
    }

    .section6 .footer-links{
      width:min(1200px, 90vw);
      margin:50px auto 60px;
      display:grid;
      grid-template-columns: repeat(4, 1fr);
      gap:40px 60px;
    }

    .section6 .footer-links .col h4{
      margin:0 0 16px; font-size:20px; font-weight:700;
    }

    .section6 .footer-links ul{
      list-style:none; padding:0; margin:0;
    }

    .section6 .footer-links li{
      margin:10px 0; position:relative; padding-left:14px;
    }

    .section6 .footer-links li::before{
      content:"▸"; position:absolute; left:0; top:0; color:#7096d6;
    }

    .section6 .footer-links a{
      color:#7096d6; text-decoration:none;
    }

    .section6 .footer-links a:hover{
      text-decoration:underline;
    }

    .section6 .copyright{
      border-top:1px solid #e8edf5; text-align:center; color:#98a7c4;
      font-size:14px; padding:18px max(8%, 40px);
    }

    .section6 .copyright a{
      color:#98a7c4; text-decoration:none;
    }

    .section6 .copyright a:hover{
      text-decoration:underline;
    }

    @media (max-width: 900px){
      .section6 .cta-bar{ flex-direction:column; align-items:flex-start; }
      .section6 .footer-links{ grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 560px){
      .section6 .footer-links{ grid-template-columns: 1fr; }
      .section6 .cta-bar h3{ font-size:28px; }
    }
  </style>
</head>

<body>


  <header class="site-header">
    <nav class="topbar">
      <div class="brand">
        <span class="be">BE</span>
        <span class="pill">SURFING</span>
      </div>

      <ul class="menu">
  <li><a href="/">HOME</a></li>
  <li><a href="/about">ABOUT</a></li>
  <li><a href="#">RENT A BOARD</a></li>
  <li><a href="#">SCHOOL</a></li>
  <li><a href="#">CONTACT</a></li>
  <li><a href="/checkout">CHECKOUT</a></li>
  <li><a href="/crud">CRUD</a></li>
</ul>

      <a class="buy" href="#">BUY NOW</a>
    </nav>
  </header>


  <div class="container my-4">
    <div class="mb-4">
      <div class="alert alert-primary text-center p-2">
        <strong>Checkout</strong> <u></u> 
      </div>
    </div>

    <div class="p-3 bg-white shadow-sm rounded">
      <h4>Customer & Shipping Info</h4>
      <form>
        <div class="mb-3">
          <label class="form-label">Full Name</label>
          <input type="text" class="form-control" placeholder="Enter your name">
        </div>

        <div class="mb-3">
          <label class="form-label">Email</label>
          <input type="email" class="form-control" placeholder="Enter your email">
        </div>

        <div class="mb-3">
          <label class="form-label">Phone</label>
          <input type="tel" class="form-control" placeholder="0300-1234567">
        </div>

        <div class="mb-3">
          <label class="form-label">Address</label>
          <input type="text" class="form-control" placeholder="House no, Street, City">
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label">City</label>
            <input type="text" class="form-control">
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label">Country</label>
          <select class="form-select">
            <option selected disabled>Select Country</option>
            <option>Pakistan</option>
            <option>USA</option>
            <option>UK</option>
          </select>
        </div>

        <div class="form-check mb-3">
          <input class="form-check-input" type="checkbox" id="sameAsShipping">
          <label class="form-check-label" for="sameAsShipping">Billing same as shipping</label>
        </div>

        <h5>Payment Method</h5>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="payment" id="card" checked>
          <label class="form-check-label" for="card">Card</label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="payment" id="cod">
          <label class="form-check-label" for="cod">Cash on Delivery</label>
        </div>
        <div class="form-check mb-3">
          <input class="form-check-input" type="radio" name="payment" id="wallet">
          <label class="form-check-label" for="wallet">Wallet</label>
        </div>

        <div class="border rounded p-3 mb-3">
          <div class="mb-3">
            <label class="form-label">Cardholder Name</label>
            <input type="text" class="form-control">
          </div>
          <div class="mb-3">
            <label class="form-label">Card Number</label>
            <input type="text" class="form-control" placeholder="">
          </div>
        </div>

        <div class="form-check mb-3">
          <input class="form-check-input" type="checkbox" id="terms">
          <label class="form-check-label" for="terms">I agree to the Terms & Conditions</label>
        </div>
        <button type="submit" class="btn btn-primary w-100" disabled>Place Order</button>
      </form>
    </div>
  </div>

  
  <footer class="section6">
    <div class="cta-bar">
      <h3>SPEND YOUR VACATION WITH US</h3>
      <a href="checkout.html" class="cta-btn">Checkout</a>
    </div>

    <div class="footer-links">
      <div class="col">
        <h4>Shortcut links</h4>
        <ul>
          <li><a href="#">Getting started</a></li>
          <li><a href="#">Pricing & rentals</a></li>
          <li><a href="#">Lessons & school</a></li>
          <li><a href="#">Contact & support</a></li>
        </ul>
      </div>

      <div class="col">
        <h4>Our mission</h4>
        <ul>
          <li><a href="#">Craftsmanship & quality</a></li>
          <li><a href="#">Sustainability practices</a></li>
          <li><a href="#">Community & events</a></li>
          <li><a href="#">Safety standards</a></li>
          <li><a href="#">Careers</a></li>
          <li><a href="#">Press & media</a></li>
          <li><a href="#">Partners</a></li>
        </ul>
      </div>

      <div class="col">
        <h4>About us</h4>
        <ul>
          <li><a href="#">Who we are</a></li>
          <li><a href="#">Our team</a></li>
          <li><a href="#">Locations</a></li>
          <li><a href="#">Testimonials</a></li>
          <li><a href="#">Blog</a></li>
          <li><a href="#">FAQ</a></li>
        </ul>
      </div>

      <div class="col">
        <h4>Departments</h4>
        <ul>
          <li><a href="#">Surf School</a></li>
          <li><a href="#">Rentals</a></li>
          <li><a href="#">Events</a></li>
          <li><a href="#">Support Center</a></li>
        </ul>
      </div>
    </div>

    <div class="copyright">
      © 2025 Betheme by <a href="#">Muffin group</a> | All Rights Reserved | Powered by <a href="#">WordPress</a>
    </div>
  </footer>

  
  <script>
    const terms = document.getElementById('terms');
    const btn = document.querySelector('button[type="submit"]');
    if (terms && btn) {
      terms.addEventListener('change', () => {
        btn.disabled = !terms.checked;
      });
    }
  </script>
</body>
</html>
